<section>
    <h2><%= seccion %></h2>

    <p>
        Estas son las reservas de salas registradas actualmente.
    </p>

    <% if (reservas.length === 0) { %>

        <p>No hay reservas registradas.</p>

    <% } else { %>

        <div>
            <% reservas.forEach(reserva => { %>

                <article>
                    <h3>Reserva #<%= reserva.id %></h3>

                    <p>
                        <strong>Estudiante:</strong>
                        <%= reserva.estudiante %>
                    </p>

                    <p>
                        <strong>Sala:</strong>
                        <%= reserva.sala %>
                    </p>

                    <p>
                        <strong>Fecha:</strong>
                        <%= reserva.fecha %>
                    </p>

                    <p>
                        <strong>Turno:</strong>
                        <%= reserva.turno %>
                    </p>

                    <p>
                        <strong>Personas:</strong>
                        <%= reserva.personas %>
                    </p>

                    <a href="/reservas/<%= reserva.id %>">
                        Ver detalle
                    </a>
                </article>

                <hr>

            <% }) %>
        </div>

    <% } %>

    <p>
        <a href="/reservas/nueva">Crear nueva reserva</a>
    </p>
</section>