<section>
    <h2>Nueva reserva</h2>

    <p>
        Completá los datos para registrar una nueva reserva.
    </p>

    <form action="/reservas" method="POST">

        <div>
            <label for="estudiante">Estudiante</label>
            <input
                type="text"
                id="estudiante"
                name="estudiante"
                value="<%= valores?.estudiante || '' %>"
                required
            >
        </div>

        <div>
            <label for="email">Email</label>
            <input
                type="email"
                id="email"
                name="email"
                value="<%= valores?.email || '' %>"
                required
            >
        </div>

        <div>
            <label for="sala">Sala</label>
            <select id="sala" name="sala" required>
                <option value="">Seleccionar sala</option>

                <% salasPermitidas.forEach(sala => { %>
                    <option
                        value="<%= sala %>"
                        <%= valores?.sala === sala ? "selected" : "" %>
                    >
                        <%= sala %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div>
            <label for="fecha">Fecha</label>
            <input
                type="text"
                id="fecha"
                name="fecha"
                value="<%= valores?.fecha || '' %>"
                placeholder="DD/MM/AAAA"
                required
            >
        </div>

        <div>
            <label for="turno">Turno</label>
            <select id="turno" name="turno" required>
                <option value="">Seleccionar turno</option>

                <% turnosPermitidos.forEach(turno => { %>
                    <option
                        value="<%= turno %>"
                        <%= valores?.turno === turno ? "selected" : "" %>
                    >
                        <%= turno %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div>
            <label for="personas">Cantidad de personas</label>
            <input
                type="number"
                id="personas"
                name="personas"
                min="1"
                max="6"
                value="<%= valores?.personas || '' %>"
                required
            >
        </div>

        <% if (errores && errores.length > 0) { %>
            <div role="alert">
                <h3>Hay errores en el formulario</h3>

                <ul>
                    <% errores.forEach(error => { %>
                        <li><%= error %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <button type="submit">Guardar reserva</button>

    </form>

    <p>
        <a href="/reservas">Volver a las reservas</a>
    </p>
</section>